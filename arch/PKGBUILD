# Maintainer: frs777 <frs777@users.noreply.github.com>
# Fork of pot-desktop - Polski fork z migracją na Tauri v2
# Wspiera Kiri Linux (fork Arch) oraz inne dystrybucje oparte na Arch

pkgname=pot-f-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="Pot-F Desktop - Polski fork aplikacji do tłumaczenia tekstu i OCR (Tauri v2)"
arch=('x86_64')
url="https://github.com/frs777/pot-f-desktop"
license=('GPL-3.0-only')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libayatana-appindicator'
    'librsvg'
    'tesseract'
    'tesseract-data-eng'
    'xdotool'
    'libxcb'
    'libxrandr'
    'xclip'
    'dbus'
)
makedepends=(
    'nodejs>=18.0.0'
    'pnpm>=8.5.0'
    'rust>=1.80.0'
    'cargo'
    'git'
)
optdepends=(
    'tesseract-data-pol: Polish language data for OCR'
    'tesseract-data-deu: German language data for OCR'
    'tesseract-data-fra: French language data for OCR'
    'tesseract-data-rus: Russian language data for OCR'
    'tesseract-data-ukr: Ukrainian language data for OCR'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/frs777/$pkgname/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    
    # Install frontend dependencies
    pnpm install --frozen-lockfile
    
    # Build the application
    pnpm tauri build
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    # Binary is already built in prepare()
    :
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    
    # Install the binary
    install -Dm755 "src-tauri/target/release/pot-f" "$pkgdir/usr/bin/pot-f"
    
    # Install desktop file
    install -Dm644 "asset/com.pot-f-desktop.desktop" "$pkgdir/usr/share/applications/com.pot-f-desktop.desktop"
    
    # Install icons
    for size in 32 64 128 256 512; do
        install -Dm644 "src-tauri/icons/${size}x${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/com.pot-f-desktop.png"
    done
    
    # Install scalable icon if exists
    if [ -f "src-tauri/icons/icon.svg" ]; then
        install -Dm644 "src-tauri/icons/icon.svg" \
            "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.pot-f-desktop.svg"
    fi
    
    # Install metainfo file
    if [ -f "com.pot_app.pot.metainfo.xml" ]; then
        install -Dm644 "com.pot_app.pot.metainfo.xml" \
            "$pkgdir/usr/share/metainfo/com.pot-f-desktop.metainfo.xml"
    fi
}

# vim:set ts=4 sw=4 et:
