        "http:allow-fetch",
        "http:allow-fetch-send",
        "http:allow-fetch-cancel",
        "http:allow-fetch-read-body",
        "http:allow-fetch-write-body",
        "core:event:default",
        "core:event:allow-emit",
        "core:event:allow-emit-to",
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:app:default",
        "core:app:allow-app-show",
        "core:app:allow-app-hide",
        "core:app:allow-app-minimize",
        "core:app:allow-app-unminimize",
        "core:app:allow-app-maximize",
        "core:app:allow-app-unmaximize",
        "core:app:allow-app-close",
        "core:window:default",
        "core:window:allow-close",
        "core:window:allow-set-always-on-top",
        "core:window:allow-set-skip-taskbar",
        "core:window:allow-set-focus",
        "core:window:allow-center",
        "core:window:allow-show",
        "core:window:allow-hide",
        "core:window:allow-set-size",
        "core:window:allow-set-position",
        "core:window:allow-outer-position",
        "core:window:allow-outer-size",
        "core:window:allow-primary-monitor",
        "core:window:allow-current-monitor",
        "core:window:allow-internal-toggle-maximize",
        "core:window:allow-maximize",
        "core:window:allow-unmaximize",
        "core:window:allow-minimize",
        "core:window:allow-unminimize",
        "core:window:allow-set-title",
        "core:window:allow-set-fullscreen",
        "core:window:allow-set-decorations",
        "core:window:allow-set-resizable",
        "core:window:allow-set-closable",
        "core:window:allow-set-minimizable",
        "core:window:allow-set-maximizable",
        "core:window:allow-set-visible-on-all-workspaces",
