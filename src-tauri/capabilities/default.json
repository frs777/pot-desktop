        "os:allow-exe-extension",
        "os:allow-os-type",
        "os:allow-family",
        "os:allow-hostname",
        "os:allow-version",
        "os:allow-locale",
        "os:allow-platform",
        "updater:default",
        "autostart:default",
        "autostart:allow-enable",
        "autostart:allow-disable",
        "autostart:allow-is-enabled",
        "store:default",
        "store:allow-get",
        "store:allow-set",
        "store:allow-delete",
        "store:allow-clear",
